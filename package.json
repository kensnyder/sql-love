{
  "name": "sql-love",
  "version": "1.1.2",
  "description": "Build SQL queries with JavaScript",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "test": "bun test",
    "test-watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "coverage-lcov": "bun test --coverage --coverage-reporter=lcov",
    "build": "npm run build:clean && npm run build:dts && npm run build:esm && npm run build:cjs && npm run build:gzip-size",
    "build:clean": "rm -Rf dist/ && mkdir dist",
    "build:dts": "yes | bunx dts-bundle-generator --no-check --project tsconfig.bundle-generator.json -o dist/index.d.ts ./index.ts",
    "build:esm": "bunx esbuild ./index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.mjs",
    "build:cjs": "bunx esbuild ./index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/index.cjs",
    "build:gzip-size": "echo 'gzipped savings and size:' && gzip -cv dist/index.mjs | wc -c"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensnyder/sql-love.git"
  },
  "keywords": [
    "SQL Builder",
    "SQL Parser",
    "Select Builder",
    "Select Parser",
    "parse SQL",
    "build SQL"
  ],
  "author": "kendsnyder@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kensnyder/sql-love/issues"
  },
  "homepage": "https://github.com/kensnyder/sql-love#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "dts-bundle-generator": "9.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "5.9.3"
  }
}
